# Copy to .env for local development — the test suite loads it. The server itself
# reads plain environment variables, so a deployment sets these on the platform
# and an MCP client sets them in its server config. The commented-out ones differ
# when set to an empty string, so uncomment them only to give a value.

# ─── Data sources (all optional; public RPCs are used when unset) ───────────────

# Contract ABI and source code tools. https://etherscan.io/apis
ETHERSCAN_API_KEY=

# Faster, archive-capable RPC. https://www.alchemy.com/
ALCHEMY_API_KEY=

# Alternative to Alchemy. https://www.infura.io/
INFURA_API_KEY=

# Faster event queries. https://envio.dev/
HYPERSYNC_API_KEY=

# Per-chain RPC overrides, as JSON. Takes precedence over the keys above.
CUSTOM_RPC=

# ─── Signing from a phone (WalletConnect) ──────────────────────────────────────

# Required for pair_phone_wallet. Free at https://dashboard.walletconnect.com
# Note there are two live dashboards: WalletConnect's own, above, and Reown's at
# https://dashboard.reown.com, from the rebrand of its developer tooling. Create the
# project under whichever you sign in to, and use the project id it gives you.
WALLETCONNECT_PROJECT_ID=

# ─── Serving MCP over HTTP instead of stdio ────────────────────────────────────
# Only needed when hosting this server; see "Hosting" in the README.

# Set to serve over HTTP. Unset means stdio, which is what local clients use.
# Also switches on the hosted guards: no localhost chain, no loopback tracing node.
MCP_HTTP_PORT=

# Bind address for the HTTP server. Default 0.0.0.0.
# MCP_HTTP_HOST=0.0.0.0

# Required whenever MCP_HTTP_PORT is set — anyone reaching the URL could
# otherwise request signatures. Generate with: openssl rand -hex 24
MCP_TOKEN=

# Public URL clients reach this server on. Advertised in the OAuth metadata,
# so it must match what the client dials, or the connector flow breaks. Wallet links
# use it too; unset, both point at localhost.
MCP_PUBLIC_URL=

# Number of reverse-proxy hops to trust for client IPs in rate limiting. Set 1 behind
# Fly or Render. Unset, no proxy is trusted.
# MCP_TRUST_PROXY=1

# Apply the hosted guards without MCP_HTTP_PORT — for a host assembling its own server
# from the library. Set before importing it.
MCP_HOSTED=

# Where pairings, OAuth tokens and the relay token are stored (under web3-tools-mcp/).
# Default ~/.config. Point it at a volume so a pairing survives a redeploy.
# XDG_CONFIG_HOME=

# Keep WalletConnect sessions and OAuth tokens in Redis rather than on disk, so
# pairings survive a redeploy on a platform with an ephemeral filesystem.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ─── Browser wallet relay ──────────────────────────────────────────────────────
# Unset, the server runs a relay on localhost itself. Set these only to point at
# a relay hosted elsewhere.

WALLET_SERVER_URL=
WALLET_TOKEN=

# ─── Tracing ───────────────────────────────────────────────────────────────────
# trace_transaction and debug_call use a node exposing debug_traceCall when the chain's
# RPC cannot trace — e.g. `anvil --fork-url <rpc>`. Nothing is started for you.

# Default http://127.0.0.1:8545 locally; a hosted server uses only an explicit value.
ANVIL_RPC_URL=

# Set to 1 to let tracing re-fork that node to replay an older transaction. This
# clears whatever state the node held.
ANVIL_ALLOW_RESET=
