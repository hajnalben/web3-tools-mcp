# Copy to .env for local development — the test suite loads it. The server itself
# reads plain environment variables, so a deployment sets these on the platform
# and an MCP client sets them in its server config.

# ─── Data sources (all optional; public RPCs are used when unset) ───────────────

# Contract ABI and source code tools. https://etherscan.io/apis
ETHERSCAN_API_KEY=

# Faster, archive-capable RPC. https://www.alchemy.com/
ALCHEMY_API_KEY=

# Alternative to Alchemy. https://www.infura.io/
INFURA_API_KEY=

# Faster event queries. https://envio.dev/
HYPERSYNC_API_KEY=

# Per-chain RPC overrides, as JSON. Takes precedence over the keys above.
CUSTOM_RPC=

# ─── Signing from a phone (WalletConnect) ──────────────────────────────────────

# Required for pair_phone_wallet. Free at https://dashboard.reown.com/
WALLETCONNECT_PROJECT_ID=

# ─── Serving MCP over HTTP instead of stdio ────────────────────────────────────
# Only needed when hosting this server; see "Hosting Your Own" in the README.

# Set to serve over HTTP. Unset means stdio, which is what local clients use.
MCP_HTTP_PORT=

# Required whenever MCP_HTTP_PORT is set — anyone reaching the URL could
# otherwise request signatures. Generate with: openssl rand -hex 32
MCP_TOKEN=

# Public URL clients reach this server on. Advertised in the OAuth metadata,
# so it must match what the client dials, or the connector flow breaks.
MCP_PUBLIC_URL=

# Keep WalletConnect sessions and OAuth tokens in Redis rather than on disk, so
# pairings survive a redeploy on a platform with an ephemeral filesystem.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ─── Browser wallet relay ──────────────────────────────────────────────────────
# Unset, the server runs a relay on localhost itself. Set these only to point at
# a relay hosted elsewhere.

WALLET_SERVER_URL=
WALLET_TOKEN=
